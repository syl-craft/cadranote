# github-secrets repo=${owner}/${project} environment=stores
# Références Vaultwarden des secrets du workflow Publication, sans aucune valeur.
@owner = syl-craft
@project = cadranote
@item = syl-craft-web-store-apps
FIREFOX_JWT_ISSUER={{ bw:${item}:FIREFOX_JWT_ISSUER }}
FIREFOX_JWT_SECRET={{ bw:${item}:FIREFOX_JWT_SECRET }}
EDGE_CLIENT_ID={{ bw:${item}:EDGE_CLIENT_ID }}
EDGE_API_KEY={{ bw:${item}:EDGE_API_KEY }}
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY={{ bw:${item}:CHROME_SERVICE_ACCOUNT_PRIVATE_KEY }}
