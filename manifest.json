{
  "manifest_version": 3,
  "name": "Cadranote — Cibler pour une IA",
  "version": "1.1.0",
  "description": "Sélectionnez un élément et copiez son sélecteur CSS, son chemin HTML et son contexte pour une IA.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Sélectionner un élément HTML (Alt+Maj+C)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Sélectionner un élément HTML"
    }
  }
}
